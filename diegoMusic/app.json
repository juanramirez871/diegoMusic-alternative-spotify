{
  "expo": {
    "name": "DiegoMusic",
    "slug": "DiegoMusic",
    "version": "3.5.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "diegomusic",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.juandiego.diegomusic",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "Permite buscar canciones y controlar la reproducción con tu voz.",
        "NSSpeechRecognitionUsageDescription": "Convierte tu voz en texto para buscar música y ejecutar comandos.",
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.824421180412-21a4barbkfjt7lbqo4a6jpnifk9qouk4"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.juandiego.diegomusic",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_AUDIO_PLAYBACK",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "notification": {
        "color": "#2c5af3"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-control",
        {
          "enableBackgroundAudio": true,
          "audioSessionCategory": "playback"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#212121"
          }
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-screen-orientation",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite buscar canciones y controlar la reproducción con tu voz.",
          "speechRecognitionPermission": "Convierte tu voz en texto para buscar música y ejecutar comandos.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "./plugins/withoutPushEntitlement"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
